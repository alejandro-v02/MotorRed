# Servicio de Ventas y contabilidad (grupo Zaidy) de MotorRed. Copie como .env y complete.
GRUPO=ventas
PUERTO=3000
# Dirección pública de este servicio (para que la pasarela nos llame de vuelta). En Docker:
# URL_PROPIA=http://ventas:3000
URL_PROPIA=http://localhost:3000

# Secreto con que este servicio firma sus propios tokens (largo y al azar en producción):
# SECRETO_JWT_VENTAS=

# Credenciales que ESTE servicio acepta de quien lo llama (CLIENTE_<cliente>_EN_VENTAS):
# CLIENTE_TALLER_EN_VENTAS=
# CLIENTE_APP_EN_VENTAS=
# CLIENTE_AUDITOR_EN_VENTAS=

# Credenciales que ESTE servicio usa para llamar a tienda y concesionario (CLIENTE_VENTAS_EN_<destino>):
# CLIENTE_VENTAS_EN_TIENDA=
# CLIENTE_VENTAS_EN_CONCESIONARIO=

# Direcciones de los demás servicios del ecosistema (por defecto, los simuladores en localhost):
# URL_TALLER=http://localhost:4101
# URL_TIENDA=http://localhost:4102
# URL_CONCESIONARIO=http://localhost:4103
# URL_PASARELA=http://localhost:4199

# Firma de los eventos que ENVIAMOS al taller, y de los que RECIBIMOS de la pasarela:
# FIRMA_EVENTOS_VENTAS=
# FIRMA_EVENTOS_PASARELA=
PASARELA_LLAVE=lab-llave-pasarela

# A dónde puede apuntar url_notificacion en crear_venta (orígenes separados por coma):
NOTIFICACIONES_PERMITIDAS=http://localhost:4101

# Base de datos propia de este servicio (una base de datos por servicio):
DB_HOST=localhost
DB_PORT=5432
DB_USUARIO=motorred
DB_CLAVE=motorred
DB_BASE=motorred_ventas

# RAG (Actividad 4.4) y agentes con modelo (Trabajo 4 y 5). Requiere Ollama corriendo:
#   ollama pull nomic-embed-text   (embeddings, 768 dimensiones)
#   ollama pull qwen2.5:7b         (o qwen3:8b; ver el Instructivo 5 sobre soporte de herramientas)
OLLAMA_URL=http://localhost:11434
EMBED_MODELO=nomic-embed-text
EMBED_DIMENSIONES=768
LLM_MODELO=qwen2.5:7b

# Parámetros tributarios de PRÁCTICA, por si la tabla parametros_tributarios aún no tiene seed:
IVA_PORCENTAJE=19
COMISION_PORCENTAJE=3
UVT=52374
RETEFUENTE_SERVICIOS=4
RETEFUENTE_SERVICIOS_BASE_UVT=2
RETEFUENTE_COMPRAS=2.5
RETEFUENTE_COMPRAS_BASE_UVT=10

# ---------- Facturación (contrato del Taller real: MCP-Taller.xlsx) ----------
# Cada grupo del que aún no se tiene contrato está detrás de un "modo". Ver docs/pendientes-contratos.md.
# Credencial que el Taller real usa para llamarnos (crear_cotizacion, notificar_reparacion_terminada):
# CLIENTE_TALLER_FACT_EN_VENTAS=
# CLIENTE_APP_FACT_EN_VENTAS=
# Llave de operador para /internos/cotizaciones/* (respuesta del cliente, bandejas):
# FACT_LLAVE_INTERNA=
# simulado = precios de datos/precios-simulados.json | real = falta escribir facturacion/adaptadores/tienda.real.ts
TIENDA_MODO=simulado
# bandeja = los avisos al cliente quedan en GET /internos/notificaciones | telegram = falta escribir notificador.telegram.ts
NOTIFICADOR_MODO=bandeja
# MCP del Taller real. Sin URL, las respuestas quedan en la bandeja de salida (GET /internos/mensajes).
# TALLER_FACT_URL=http://localhost:4111
# TALLER_FACT_TOKEN=
COTIZACION_VIGENCIA_HORAS=48
# 1 si el cliente es agente de retención (el Taller no envía ese dato)
CLIENTE_RETENEDOR=0
