{
  "name": "motorred-ventas",
  "version": "1.0.0",
  "description": "Servicio de Ventas y contabilidad (grupo Zaidy) del ecosistema MotorRed: orquestador comercial con MCP, PostgreSQL, saga de pago y agentes de IA",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "tsc && node dist/main.js",
    "dev": "tsc --watch",
    "migration:run": "tsc && node dist/db/correr-migraciones.js",
    "migration:revert": "tsc && node dist/db/revertir-migracion.js",
    "seed": "tsc && node dist/db/seed.js",
    "evaluar-riesgo": "tsc && node dist/agentes/evaluar-riesgo.js"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/typeorm": "^12.0.2",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "typescript": "^6.0.2"
  }
}
