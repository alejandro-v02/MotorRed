# Configuración del ecosistema MotorRed. Copie este archivo como .env y cambie lo que necesite.
# Los valores por defecto sirven para el laboratorio; en una demostración pública cámbielos TODOS.

# ---------- Dónde está cada servicio ----------
# Para conectar el servicio real de un grupo, ponga aquí su dirección y arranque el ecosistema sin
# su simulador:  node ecosistema.mjs --sin tienda
# URL_TALLER=http://localhost:4101
# URL_TIENDA=http://localhost:4102
# URL_CONCESIONARIO=http://localhost:4103
# URL_VENTAS=http://localhost:4104
# URL_PASARELA=http://localhost:4199

# ---------- Secretos (cada grupo guarda solo los suyos) ----------
# Secreto con que cada servicio firma SUS tokens:
# SECRETO_JWT_TIENDA=
# Credencial de un cliente en un servidor (CLIENTE_<quien llama>_EN_<a quien llama>):
# CLIENTE_TALLER_EN_TIENDA=
# CLIENTE_VENTAS_EN_TIENDA=
# Secretos de firma de los eventos (webhooks):
# FIRMA_EVENTOS_VENTAS=
# FIRMA_EVENTOS_PASARELA=
# PASARELA_LLAVE=
# 1 = la pasarela envía cada evento dos veces (prueba de idempotencia)
PASARELA_DUPLICAR=1

# ---------- Parámetros comerciales y tributarios (VALORES DE PRÁCTICA) ----------
VALOR_HORA_TALLER=95000
IVA_PORCENTAJE=19
COMISION_PORCENTAJE=3
UVT=52374
RETEFUENTE_SERVICIOS=4
RETEFUENTE_SERVICIOS_BASE_UVT=2
RETEFUENTE_COMPRAS=2.5
RETEFUENTE_COMPRAS_BASE_UVT=10

# ---------- Modelo de lenguaje de los agentes ----------
# Local (Ollama):
LLM_URL=http://localhost:11434/v1
LLM_LLAVE=ollama
LLM_MODELO=llama3.2
# En la nube (por ejemplo Groq):
# LLM_URL=https://api.groq.com/openai/v1
# LLM_LLAVE=su_llave
# LLM_MODELO=openai/gpt-oss-20b
